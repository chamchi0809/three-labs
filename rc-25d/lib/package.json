{
  "name": "@rc25d/radiance-cascades",
  "version": "0.1.0",
  "description": "Turnkey 2.5D Radiance Cascades lighting for three.js WebGPU",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "check": "node --experimental-strip-types --disable-warning=ExperimentalWarning hrc.check.ts && node --experimental-strip-types --disable-warning=ExperimentalWarning splitrc.check.ts",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "pnpm build"
  },
  "peerDependencies": {
    "three": ">=0.180.0"
  }
}
