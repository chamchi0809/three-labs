@import "./materials.tscene";

--height: 1.5;

group #stage {
  mesh.floor #ground {
    geometry: boxGeometry(20, 0.2, 20);
    position: vec3(0, -0.1, 0);
    material: meshStandardMaterial();
  }
  mesh.glow #spinner {
    geometry: torusKnotGeometry(0.7, 0.24, 160, 32);
    position: vec3(0, var(--height), 0);
    rotation: euler(20deg, 0, 0);
    userData: { spin: 0.5 };
  }
  mesh.glow #satellite {
    --tint: #7fd1ff;
    geometry: sphereGeometry(0.3, 32, 16);
    position: vec3(2.2, calc(var(--height) * 2), 0);
  }
  mesh #pillar {
    geometry: cylinderGeometry(0.25, 0.25, 2);
    position: vec3(-2.5, 1, 0);
    material: meshStandardMaterial {
      color: color(#7fd1ff);
      roughness: 0.2;
      side: FrontSide;
    };
    castShadow: true;
  }
  // loaded model: the whole scene comes in as a child, find() reaches into it, play() runs a clip
  gltf #robot("../assets/robot.glb") {
    position: vec3(-1.4, 0, -1.6);
    rotation: euler(0, 25deg, 0);
    find(mesh, "Body") { castShadow: true; }
    find(mesh, "Head") { castShadow: true; }
    // Mesh.material is typed as Material, so only Material's own properties pass the checker here
    find#eye(mesh, "Eye") {
      material.transparent: true;
      material.opacity: 0.75;
    }
    play("Idle") {
      timeScale: 0.8;
      weight: 1;
    }
  }
  // texture(): the vite plugin turns the relative path into a hashed ?url import
  mesh #screen {
    geometry: planeGeometry(1.6, 1.6);
    position: vec3(3.4, 1.2, -1);
    rotation: euler(0, -25deg, 0);
    material: meshStandardMaterial {
      map: texture("../assets/checker.png");
      roughness: 0.6;
    };
    material.map.magFilter: NearestFilter;
    material.map.colorSpace: SRGBColorSpace;
    receiveShadow: true;
  }
  pointLight #lamp(#ffd9a0, 30, 20) {
    position: vec3(2.5, 3, 2);
    castShadow: true;
  }
  ambientLight(#334455, 1.2)
}
