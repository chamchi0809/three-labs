{
  "name": "tscene-editor",
  "private": true,
  "type": "module",
  "description": "three-broom — a TrenchBroom-like brush editor that reads and writes .tscene",
  "scripts": {
    "dev": "vite --configLoader runner",
    "build": "vite build --configLoader runner",
    "preview": "vite preview",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json",
    "check": "node --experimental-strip-types --disable-warning=ExperimentalWarning src/grid/snap.check.ts"
  },
  "dependencies": {
    "tscene": "workspace:*"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "svelte": "^5.55.2",
    "svelte-check": "^4.3.4"
  }
}
