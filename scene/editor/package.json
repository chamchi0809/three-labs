{
  "name": "tscene-editor",
  "private": true,
  "type": "module",
  "description": "three-broom — a TrenchBroom-like brush editor that reads and writes .tscene",
  "main": "./src/mount.ts",
  "types": "./src/mount.ts",
  "svelte": "./src/mount.ts",
  "exports": {
    ".": {
      "svelte": "./src/mount.ts",
      "types": "./src/mount.ts",
      "default": "./src/mount.ts"
    },
    "./vite": "./src/io/server.ts"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json",
    "check": "node --experimental-strip-types --disable-warning=ExperimentalWarning src/checks.ts"
  },
  "dependencies": {
    "tscene": "workspace:*"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "@tabler/icons-svelte": "^3.46.0",
    "svelte": "^5.55.2",
    "svelte-check": "^4.3.4"
  }
}
