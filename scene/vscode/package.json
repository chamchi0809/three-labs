{
  "name": "tscene-vscode",
  "displayName": "tscene",
  "description": "Syntax highlighting, type checking, completion and formatting for .tscene files",
  "version": "0.4.0",
  "license": "MIT",
  "publisher": "chamchi",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/chamchi0809/three-labs.git",
    "directory": "scene/vscode"
  },
  "bugs": {
    "url": "https://github.com/chamchi0809/three-labs/issues"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Formatters"
  ],
  "main": "./dist/extension.js",
  "scripts": {
    "bundle": "node bundle.mjs",
    "check": "node bundle.mjs && node grammar.check.mjs",
    "vscode:prepublish": "node bundle.mjs"
  },
  "activationEvents": [
    "onLanguage:scene"
  ],
  "contributes": {
    "languages": [
      {
        "id": "scene",
        "aliases": [
          "tscene",
          "scene"
        ],
        "extensions": [
          ".tscene"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icon.svg",
          "dark": "./icon.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "scene",
        "scopeName": "source.scene",
        "path": "./syntaxes/scene.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "scene",
        "path": "./snippets/scene.json"
      }
    ],
    "commands": [
      {
        "command": "tscene.format",
        "title": "tscene: Fix and format this file"
      },
      {
        "command": "tscene.checkWorkspace",
        "title": "tscene: Check all .tscene files"
      },
      {
        "command": "tscene.fixWorkspace",
        "title": "tscene: Fix all .tscene files"
      },
      {
        "command": "tscene.restart",
        "title": "tscene: Restart language server"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "tscene.format",
          "when": "editorLangId == scene",
          "group": "1_modification"
        }
      ]
    },
    "configuration": {
      "title": "tscene",
      "properties": {
        "tscene.entry": {
          "type": "string",
          "default": "three/webgpu",
          "description": "three entry point whose typings drive the checker (three/webgpu or three)."
        },
        "tscene.modules": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Extra modules whose exported classes become usable nodes and values (e.g. ./src/Water.ts)."
        },
        "tscene.addons": {
          "type": "boolean",
          "default": true,
          "description": "Reflect three/addons too, so every addon class (loftGeometry, roomEnvironment, …) is a usable node."
        },
        "tscene.declare": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Node names your app registers at runtime (loadScene's `registry`). They are accepted without type checking."
        },
        "tscene.nodePath": {
          "type": "string",
          "default": "",
          "description": "node binary used to run the language server. Empty uses the one bundled with VS Code."
        },
        "tscene.serverPath": {
          "type": "string",
          "default": "",
          "description": "Path to tscene's language server entry. Empty resolves it from the workspace's node_modules."
        },
        "tscene.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Log LSP traffic to the tscene output channel."
        }
      }
    },
    "configurationDefaults": {
      "[scene]": {
        "editor.tabSize": 2,
        "editor.formatOnSave": true,
        "editor.suggest.insertMode": "replace"
      }
    }
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/vscode": "^1.90.0",
    "esbuild": "^0.28.2",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.1.0"
  }
}
