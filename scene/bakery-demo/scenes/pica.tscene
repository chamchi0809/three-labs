// PICA PICA Mini Diorama 01 — the glb rc-25d/demo already ships, baked instead of voxelised.
// Scene by SEED.EA (https://github.com/SEED-EA/pica-pica-assets), CC BY-NC 4.0.
//
// It is here for what the Cornell box cannot show: 170 meshes and 28 materials, so the unwrap has to
// pack a real scene rather than nine quads, and the light is the diorama's own — the three emissive
// surfaces rc-25d lights it with, plus a raking sun and the sky over the open corner. `Glass_Dark_01`
// is transparent *and* transmissive, so its shadow is the see-through kind.
//
// The path reaches out of this package: the asset lives with the demo that brought it in, and the
// vite plugin hashes it into this bundle from there. Nothing is copied.
//
// Three of its 28 materials are metals, which no lightmap can light — three's diffuse colour is
// `albedo * (1 - metalness)` — so the bake also captures reflection probes for them to reflect. That
// is the specular half of the same trace, and it is why the screws and the gauge front show the
// diorama's own red and cyan glow instead of rendering black.

@bakery {
  out: "../public/lightmaps";
  // 170 charts want the room: at 1024 the small props get a handful of texels each
  size: 2048;
  samples: 512;
  ao: true;
}

gltf #diorama("../../../rc-25d/demo/public/assets/pica_pica/mini_diorama_01.glb") {
  scale: vec3(10, 10, 10);

  // rc-25d's own emissive presets. Each material is shared by every mesh that uses it, so one find()
  // per material lights all of them — and to the baker each is an area light sampled by triangle area.
  find(mesh, "Led_01_Glass_Dark_01_0") {
    material.emissive: color(#63d8ff);
    material.emissiveIntensity: 22;
  }
  find(mesh, "Floor_Junk_Cluster_01_Pin1_Plastic_Red_Transparent_0") {
    material.emissive: color(#ff294d);
    material.emissiveIntensity: 8;
  }
  find(mesh, "Wax_Pastel_03_Wax_Pastel_Yellow_01_0") {
    material.emissive: color(#ffa31a);
    material.emissiveIntensity: 5;
  }
}

// What the metals reflect. `nearestProbe` gives a mesh the probe closest to its bounding-box centre,
// so a probe per metal is a probe per reflection: 32 metal meshes here, grouped into these 15 by
// distance — anything within 0.7 of a neighbour reflects near enough the same surroundings to share
// one — and each sitting just above its group rather than inside it, since a probe inside a screw
// sees the inside of a screw. 128 wide is a blurry mirror, which is what a bolt is.
//
// The pipes and the bolts come in pairs because the diorama has two copies of the same machine, a and
// b, one against each wall. The ones marked tight are within a few centimetres of the surface their
// group rests on, so most of what they reflect is that surface — correct for a bolt lying on a plate.
object3D #probe_junk_pile   { position: vec3(-0.77, 0.75, 1.01);  @bakery { probe: 128 }; }  // 5 meshes
object3D #probe_junk_bolts  { position: vec3(-2.13, 0.40, 0.60);  @bakery { probe: 128 }; }
object3D #probe_led_wire    { position: vec3(0.62, 1.04, 1.46);   @bakery { probe: 128 }; }  // 4 meshes
object3D #probe_interior    { position: vec3(1.03, 1.22, 1.26);   @bakery { probe: 128 }; }
object3D #probe_screw       { position: vec3(1.59, 0.94, 1.38);   @bakery { probe: 128 }; }

object3D #probe_pipes_a1    { position: vec3(-4.59, 0.08, -0.54); @bakery { probe: 128 }; }
object3D #probe_pipes_a2    { position: vec3(-4.60, 0.08, 0.40);  @bakery { probe: 128 }; }
object3D #probe_bolts_a1    { position: vec3(-3.33, 0.20, 0.41);  @bakery { probe: 128 }; }  // tight
object3D #probe_bolts_a2    { position: vec3(-3.35, 0.20, -0.57); @bakery { probe: 128 }; }  // tight
object3D #probe_inlet_a     { position: vec3(-3.65, 1.40, -0.08); @bakery { probe: 128 }; }

object3D #probe_pipes_b1    { position: vec3(-1.11, 0.07, -3.99); @bakery { probe: 128 }; }
object3D #probe_pipes_b2    { position: vec3(-2.05, 0.07, -3.99); @bakery { probe: 128 }; }
object3D #probe_bolts_b1    { position: vec3(-2.06, 0.19, -2.72); @bakery { probe: 128 }; }  // tight
object3D #probe_bolts_b2    { position: vec3(-1.08, 0.19, -2.74); @bakery { probe: 128 }; }  // tight
object3D #probe_inlet_b     { position: vec3(-1.58, 1.39, -3.04); @bakery { probe: 128 }; }

// the diorama is a corner: two walls, an open front, and nothing above it
hemisphereLight #sky(#cfe4ff, #4a4038, 0.8)

// `radius` is angular here, in radians — a 1.7 degree sun raking in over the open side
directionalLight #sun(#fff3e0, 2.2) {
  position: vec3(7, 9, 6);
  @bakery { radius: 0.03 };
}
